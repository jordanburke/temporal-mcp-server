{
  "name": "temporal-mcp-server",
  "version": "0.2.3",
  "description": "MCP server for time, timezone, and duration tools. Runs locally over stdio and on Cloudflare Workers.",
  "mcpName": "io.github.jordanburke/temporal-mcp-server",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "time",
    "timezone",
    "duration",
    "cloudflare-workers",
    "somamcp",
    "typescript"
  ],
  "author": "jordan.burke@gmail.com",
  "license": "MIT",
  "homepage": "https://github.com/jordanburke/temporal-mcp-server",
  "repository": {
    "type": "git",
    "url": "https://github.com/jordanburke/temporal-mcp-server"
  },
  "bin": {
    "temporal-mcp-server": "./dist/node.js"
  },
  "scripts": {
    "validate": "ts-builds validate",
    "format": "ts-builds format",
    "format:check": "ts-builds format:check",
    "lint": "ts-builds lint",
    "lint:check": "ts-builds lint:check",
    "typecheck": "ts-builds typecheck",
    "test": "ts-builds test",
    "test:watch": "ts-builds test:watch",
    "test:coverage": "ts-builds test:coverage",
    "build": "pnpm check:version && ts-builds build && pnpm check:worker",
    "check:worker": "node scripts/check-worker-bundle.mjs",
    "dev": "ts-builds dev",
    "start": "node dist/node.js",
    "start:http": "node dist/node.js --http",
    "cf:dev": "wrangler dev",
    "cf:deploy": "pnpm build && node scripts/deploy.mjs",
    "prepublishOnly": "pnpm validate && pnpm check:version && pnpm check:worker && pnpm check:server-json",
    "sync:version": "node scripts/sync-version.mjs",
    "check:version": "node scripts/sync-version.mjs --check",
    "sync:server-json": "node scripts/sync-server-json.mjs",
    "check:server-json": "node scripts/sync-server-json.mjs --check",
    "version": "node scripts/sync-version.mjs && node scripts/sync-server-json.mjs && git add src/version.ts server.json"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "ts-builds": "^3.3.0",
    "tsdown": "^0.22.14",
    "wrangler": "^4.123.0"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js",
      "default": "./dist/worker.js"
    }
  },
  "files": [
    "dist"
  ],
  "prettier": "ts-builds/prettier",
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "dependencies": {
    "functype": "^1.8.0",
    "somamcp": "1.3.0",
    "zod": "^4.4.3"
  }
}
